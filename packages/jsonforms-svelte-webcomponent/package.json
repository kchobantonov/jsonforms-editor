    "@chobantonov/jsonforms-svelte-flowbite-extended": "1.0.1",
    "@chobantonov/jsonforms-svelte-skeleton": "1.0.1",
    "@chobantonov/jsonforms-svelte-skeleton-extended": "1.0.1",
    "@jsonforms/core": "3.7.0",
    "@lucide/svelte": "^0.542.0",
    "@skeletonlabs/skeleton": "4.12.1",
    "@skeletonlabs/skeleton-svelte": "4.12.1",
    "ajv": "^8.6.1",
    "ajv-errors": "^3.0.0",
    "ajv-i18n": "^4.2.0",
    "ajv-keywords": "^5.1.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.10.6",
    "flowbite": "4.0.1",
    "flowbite-svelte": "1.31.0",
    "flowbite-svelte-icons": "3.1.0",
    "flowbite-typography": "^1.0.5",
    "lodash": "^4.17.21",
    "maska": "^3.2.0",
    "shady-css-parser": "^0.1.0",
    "tailwind-merge": "^3.4.0",
    "tailwind-variants": "^3.2.2",
    "tslib": "^2.7.0"
