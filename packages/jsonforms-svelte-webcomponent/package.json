{
  "name": "@chobantonov/jsonforms-svelte-webcomponent",
  "version": "0.1.0",
  "description": "JSON Forms Svelte Web Component",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kchobantonov/jsonforms-editor.git",
    "directory": "packages/jsonforms-svelte-webcomponent"
  },
  "bugs": "https://github.com/kchobantonov/jsonforms-editor/issues",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "directories": {
    "src": "src",
    "test": "test"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "prebuild": "rimraf dist",
    "build": "run-s check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "cross-env NODE_OPTIONS=\"--max-old-space-size=4096\" vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write src/",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@chobantonov/jsonforms-svelte": "1.0.1",
    "@chobantonov/jsonforms-svelte-extended": "1.0.1",
